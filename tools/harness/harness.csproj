<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>net10.0</TargetFramework>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <AssemblyName>harness</AssemblyName>
        <RootNamespace>harness</RootNamespace>
        <InvariantGlobalization>false</InvariantGlobalization>
        <DebugType>embedded</DebugType>
    </PropertyGroup>

    <ItemGroup>
        <ProjectReference Include="..\..\Witcher3StringEditor.Contracts\Witcher3StringEditor.Contracts.csproj"/>
        <ProjectReference Include="..\..\Witcher3StringEditor.Serializers\Witcher3StringEditor.Serializers.csproj"/>
    </ItemGroup>

    <!-- Cross-platform model and converters for recording the settings JSON round trip. -->
    <ItemGroup>
        <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2"/>
        <Compile Include="..\..\Witcher3StringEditor\Models\AppSettings.cs" Link="Models\AppSettings.cs"/>
        <Compile Include="..\..\Witcher3StringEditor\Models\BackupItem.cs" Link="Models\BackupItem.cs"/>
        <Compile Include="..\..\Witcher3StringEditor\Models\RecentItem.cs" Link="Models\RecentItem.cs"/>
        <Compile Include="..\..\Witcher3StringEditor.Miscellaneous\EncodingJsonConverter.cs" Link="Converters\EncodingJsonConverter.cs"/>
        <Compile Include="..\..\Witcher3StringEditor.Miscellaneous\LanguageJsonConverter.cs" Link="Converters\LanguageJsonConverter.cs"/>
        <Compile Include="..\..\Witcher3StringEditor.Miscellaneous\InterfaceJsonConverter.cs" Link="Converters\InterfaceJsonConverter.cs"/>
        <Compile Include="..\..\Witcher3StringEditor.Miscellaneous\ObservableCollectionJsonConverter.cs" Link="Converters\ObservableCollectionJsonConverter.cs"/>
    </ItemGroup>

</Project>
